{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-workbench.invalid/contracts/v2/schemas/search-plan.schema.json",
  "title": "SearchPlan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "briefId", "scope", "revision", "steps", "stopConditions", "reasonCodes", "createdAt", "versions"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "planId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "briefId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "scope": { "$ref": "common.schema.json#/$defs/Scope" },
    "revision": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/PlanStep" }
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/reasonCode" }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "versions": { "$ref": "common.schema.json#/$defs/Versions" }
  },
  "$defs": {
    "PlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "facet", "objective", "queries", "preferredTools", "dependsOn", "evidenceNeeded", "status"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "facet": { "type": "string", "minLength": 1, "maxLength": 200 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 500 },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/opaqueId" }
        },
        "queries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "preferredTools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/opaqueId" }
        },
        "evidenceNeeded": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["todo", "running", "done", "blocked", "skipped"] }
      }
    }
  }
}
