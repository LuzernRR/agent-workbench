{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-workbench.invalid/contracts/v2/schemas/tool.schema.json",
  "title": "Tool contracts v2",
  "oneOf": [
    { "$ref": "#/$defs/ToolSpec" },
    { "$ref": "#/$defs/ToolCall" },
    { "$ref": "#/$defs/ToolResult" },
    { "$ref": "#/$defs/ToolError" }
  ],
  "$defs": {
    "ToolSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "toolId",
        "version",
        "description",
        "capabilities",
        "sourceTypes",
        "permissions",
        "approval",
        "effect",
        "reversibility",
        "cost",
        "idempotency",
        "timeoutMs",
        "parametersSchema",
        "resultSchema",
        "strictModeBeta"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "toolId": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "version": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/opaqueId" }
        },
        "sourceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/sourceType" }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/opaqueId" }
        },
        "approval": { "enum": ["never", "conditional", "always"] },
        "effect": { "enum": ["read", "write", "external_side_effect"] },
        "reversibility": { "enum": ["read_only", "reversible", "compensatable", "irreversible"] },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["estimatedUsd", "unit"],
          "properties": {
            "estimatedUsd": { "$ref": "common.schema.json#/$defs/decimalUsd" },
            "unit": { "enum": ["call", "item", "megabyte", "second"] }
          }
        },
        "idempotency": { "enum": ["none", "key_required", "provider_managed"] },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "parametersSchema": {
          "type": "object",
          "required": ["$schema", "type", "additionalProperties"],
          "properties": {
            "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
            "type": { "const": "object" },
            "additionalProperties": { "const": false }
          }
        },
        "resultSchema": {
          "type": "object",
          "required": ["$schema", "type", "additionalProperties"],
          "properties": {
            "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
            "type": { "const": "object" },
            "additionalProperties": { "const": false }
          }
        },
        "strictModeBeta": { "type": "boolean" }
      }
    },
    "ToolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "toolCallId", "operationRef", "toolId", "scope", "arguments", "idempotencyKey", "createdAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "toolCallId": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "operationRef": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "toolId": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "arguments": {
          "type": "object"
        },
        "idempotencyKey": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/idempotencyKey" },
            { "type": "null" }
          ]
        },
        "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "ToolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "toolCallId", "toolId", "scope", "status", "outputRef", "operationRef", "artifactIds", "evidenceIds", "summary", "error", "attempt", "usage", "completedAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "toolCallId": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "toolId": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "status": { "enum": ["succeeded", "failed", "cancelled", "unknown"] },
        "outputRef": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "operationRef": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/opaqueId" },
            { "type": "null" }
          ]
        },
        "artifactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/opaqueId" }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/opaqueId" }
        },
        "summary": { "type": "string", "maxLength": 2000 },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/ToolError" },
            { "type": "null" }
          ]
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "usage": { "$ref": "common.schema.json#/$defs/ToolUsage" },
        "completedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["failed", "unknown"] } }, "required": ["status"] },
          "then": { "properties": { "error": { "$ref": "#/$defs/ToolError" } } },
          "else": { "properties": { "error": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "unknown" } }, "required": ["status"] },
          "then": {
            "properties": {
              "outputRef": { "type": "null" },
              "operationRef": { "$ref": "common.schema.json#/$defs/opaqueId" },
              "error": {
                "allOf": [
                  { "$ref": "#/$defs/ToolError" },
                  {
                    "type": "object",
                    "properties": {
                      "category": { "const": "outcome_unknown" },
                      "retryable": { "const": false },
                      "nextAction": { "const": "check_operation" }
                    }
                  }
                ]
              },
              "usage": {
                "allOf": [
                  { "$ref": "common.schema.json#/$defs/ToolUsage" },
                  { "type": "object", "properties": { "actualCostUsd": { "type": "null" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "ToolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "message", "fieldPath", "expected", "retryable", "retryAfterMs", "nextAction", "providerStatus"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/opaqueId" },
        "category": { "enum": ["invalid_arguments", "permission_denied", "auth_required", "rate_limited", "timeout", "provider_unavailable", "output_invalid", "empty_result", "not_found", "conflict", "cancelled", "outcome_unknown", "internal"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "fieldPath": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 300 }, { "type": "null" }] },
        "expected": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 500 }, { "type": "null" }] },
        "retryable": { "type": "boolean" },
        "retryAfterMs": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 86400000 }, { "type": "null" }] },
        "nextAction": { "enum": ["repair_arguments", "request_approval", "connect_account", "retry_wait", "retry_same", "fallback_provider", "replan", "check_operation", "stop"] },
        "providerStatus": {
          "oneOf": [
            { "type": "integer", "minimum": 100, "maximum": 599 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
