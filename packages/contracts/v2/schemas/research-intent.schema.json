{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-workbench.invalid/contracts/v2/schemas/research-intent.schema.json",
  "title": "ResearchIntent v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intentId",
    "scope",
    "taskType",
    "searchNeed",
    "freshness",
    "dateFrom",
    "dateTo",
    "sourceTypes",
    "platforms",
    "outputMode",
    "depth",
    "language",
    "riskFlags",
    "missingCriticalFields",
    "confidence",
    "reasonCodes",
    "createdAt",
    "versions"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "intentId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "scope": { "$ref": "common.schema.json#/$defs/Scope" },
    "taskType": {
      "enum": ["direct_answer", "fact_lookup", "exploratory_research", "comparison", "recommendation", "fact_check", "source_find", "monitoring", "private_rag"]
    },
    "searchNeed": { "enum": ["none", "optional", "required"] },
    "freshness": { "enum": ["timeless", "recent", "latest", "bounded"] },
    "dateFrom": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/date" },
        { "type": "null" }
      ]
    },
    "dateTo": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/date" },
        { "type": "null" }
      ]
    },
    "sourceTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/sourceType" }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "outputMode": { "enum": ["short", "answer", "table", "report", "json", "dataset"] },
    "depth": { "enum": ["quick", "balanced", "deep"] },
    "language": { "$ref": "common.schema.json#/$defs/languageTag" },
    "riskFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["time_sensitive", "high_stakes", "privacy", "prompt_injection", "conflicting_sources", "ambiguous"] }
    },
    "missingCriticalFields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/reasonCode" }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "versions": { "$ref": "common.schema.json#/$defs/Versions" }
  }
}
