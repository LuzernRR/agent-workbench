{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-workbench.invalid/contracts/v2/schemas/research-brief.schema.json",
  "title": "ResearchBrief v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "briefId",
    "intentId",
    "scope",
    "objective",
    "deliverables",
    "facets",
    "mustInclude",
    "mustExclude",
    "sourcePolicy",
    "freshness",
    "depth",
    "acceptance",
    "assumptions",
    "constraints",
    "createdAt",
    "versions"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "briefId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "intentId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "scope": { "$ref": "common.schema.json#/$defs/Scope" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "facets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "mustInclude": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "mustExclude": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedTypes", "requiredTypes", "allowedDomains", "deniedDomains"],
      "properties": {
        "allowedTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/sourceType" }
        },
        "requiredTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/sourceType" }
        },
        "allowedDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "hostname" }
        },
        "deniedDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "hostname" }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "maxAgeDays", "asOf"],
      "properties": {
        "requirement": { "enum": ["timeless", "recent", "latest", "bounded"] },
        "maxAgeDays": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "asOf": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    },
    "depth": { "enum": ["quick", "balanced", "deep"] },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "versions": { "$ref": "common.schema.json#/$defs/Versions" }
  }
}
