# 仅作变量清单；不要在此提交真实密码、Token 或 API Key。
# 从此文件复制到被忽略的 config/deploy.local.env 后再填入真实值。
POSTGRES_DB=agent_workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=15432
POSTGRES_VOLUME_NAME=001-agent-live-postgres-v1
WORKBENCH_DATABASE_URL=
WORKBENCH_DATABASE_SSL=false
WORKBENCH_DATABASE_POOL_MAX=10
WORKBENCH_WORKER_DATABASE_POOL_MAX=5
WORKBENCH_RUN_LEASE_MS=30000
WORKBENCH_RUN_HEARTBEAT_MS=10000
WORKBENCH_RUN_POLL_MS=500

SEARCH_AGENT_IMAGE=agent-workbench/search-agent:local
SEARCH_AGENT_BIND_ADDRESS=127.0.0.1
SEARCH_AGENT_HOST_PORT=8080
SEARCH_AGENT_DATABASE_URL=
SEARCH_AGENT_MILVUS_URI=http://milvus:19530
WORKBENCH_INTERNAL_TOKEN=
# 独立随机值，UTF-8 至少 32 字节；不得复用或派生自 WORKBENCH_INTERNAL_TOKEN。
WORKBENCH_TENANT_ASSERTION_SECRET=

# 本地镜像基于 v2.2.6 / a5bb5b872b1670e8ce557c1942c149f74dfd8246，
# 最终层替换为仓内受控补丁二进制；升级说明见 services/xiaohongshu-mcp/UPSTREAM.md。
XIAOHONGSHU_MCP_IMAGE=agent-workbench/xiaohongshu-mcp:local
# 仅保存 MCP 的浏览器配置与 Cookie，不与 Postgres、Milvus 共用。
XIAOHONGSHU_MCP_VOLUME_NAME=001-agent-live-xiaohongshu-session-v2

WEB_IMAGE=agent-workbench/web:local
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# 新建独立的 D 盘数据根，绝不要填写现有 D:/milvus。
MILVUS_DATA_DIRECTORY=D:/001-agent/milvus
MILVUS_ROOT_PASSWORD=
MILVUS_MINIO_ROOT_USER=
MILVUS_MINIO_ROOT_PASSWORD=

AGENT_BACKEND_NETWORK=001-agent-live-backend
AGENT_MILVUS_NETWORK=001-agent-live-milvus
XIAOHONGSHU_MCP_NETWORK=001-agent-live-xiaohongshu
XIAOHONGSHU_MCP_EGRESS_NETWORK=001-agent-live-xiaohongshu-egress
